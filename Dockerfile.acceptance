FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/opt/chromium \
    PORT=8080
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit \
    && npx playwright install --with-deps --only-shell chromium \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY app ./app
COPY legacy-pdf ./legacy-pdf
COPY scripts ./scripts
COPY services ./services
COPY src ./src
RUN npm run build:acceptance \
    && chown -R node:node /app /opt/chromium
USER node
EXPOSE 8080
CMD ["node", "scripts/serve-acceptance.cjs"]
